{
    "audioAE": {
        "hotkey": "^4",
        "context": "CSwitchboard",
        "command":  "ShowHideAudio",
        "withinAE": "(Application > Window >) Show/Hide Audio Panel"
    },
    "effectsAE": {
        "hotkey": "^5",
